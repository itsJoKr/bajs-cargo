// The city's one surface material: facades, roofs, streets, kerbs, parks.
//
// Every baked vertex says which atlas tile it shows (UV1.x) and its
// roughness (UV1.y); UV0 counts tile repeats (bays and storeys on a
// facade, metres / period on the ground). The shader repeats the tile
// inside its atlas cell with fract(), so one texture and one draw cover
// every surface kind in a chunk.
//
// Atlas layout (tool/prepare_textures.py): `columns` x `columns` square
// cells, each holding its tile with `padding` of wrapped tile content on
// every side, so bilinear and mip filtering near a tile edge sample the
// same tile's opposite edge rather than a neighbour. The alpha channel is
// the tint mask: 1 where the vertex colour tints the texture (stucco,
// asphalt), 0 where the texture keeps its own colour (window glass, stone
// trims). Textures are stored sRGB and linearised here.
//
// UV1.x < 0 selects the hero atlas instead, sampled at UV0 directly: a
// Street View facade is a unique picture, not a repeating tile.

material {
  name: "CityAtlas",
  shading_model: lit,
  blending: opaque,
  culling: back,

  parameters: [
    { type: sampler2d, name: atlas, hint: default_white },
    { type: sampler2d, name: hero_atlas, hint: default_white },
    { type: float, name: columns, default: 8.0 },
    { type: float, name: padding, default: 0.0625 },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    vec2 info = GetUV1();
    vec4 tint = GetVertexColor();
    vec4 tex;
    if (info.x < -0.5) {
      tex = texture(hero_atlas, uv);
    } else {
      float cols = material_params.columns;
      float pad = material_params.padding;
      float tile = floor(info.x + 0.5);
      vec2 cell = vec2(mod(tile, cols), floor(tile / cols));
      float inner = 1.0 - 2.0 * pad;
      // v counts upward on a facade; image rows count downward.
      vec2 flipped = vec2(uv.x, -uv.y);
      vec2 atlas_uv = (cell + vec2(pad) + fract(flipped) * inner) / cols;
      // Gradients of the unwrapped coordinates: fract() alone would give
      // every tile edge a derivative spike and a one-pixel seam at the
      // smallest mip.
      float scale = inner / cols;
      tex = textureGrad(atlas, atlas_uv, dFdx(flipped) * scale,
                        dFdy(flipped) * scale);
    }
    vec3 albedo = SRGBToLinear(tex.rgb);
    albedo *= mix(vec3(1.0), tint.rgb, tex.a);
    material.base_color = vec4(albedo, 1.0);
    material.roughness = info.y > 0.01 ? info.y : 0.85;
    material.metallic = 0.0;
    PrepareMaterial(material);
  }
}
