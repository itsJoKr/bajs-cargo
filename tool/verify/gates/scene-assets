#!/usr/bin/env bash
# Structural gate over the baked city: every chunk document parses with
# package:scene, its payload sidecar matches, each chunk the index names is
# listed for the build hook, and the collision/terrain data loads. Fast and
# device-free, so a loop can run it on every iteration.
set -uo pipefail

if [ "${1:-}" = "--describe" ]; then
  echo '{"name":"scene-assets","tier":1,"summary":"baked chunks, collision and terrain data are consistent","needs":[]}'
  exit 0
fi

cd "$(dirname "$0")/../../.." || exit 1
OUT=$(fvm flutter test test/city_asset_test.dart 2>&1)
code=$?
echo "$OUT" | tail -30
if [ "$code" -ne 0 ] || ! echo "$OUT" | grep -q "All tests passed!"; then
  exit 1
fi
exit 0
