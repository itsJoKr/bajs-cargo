#!/usr/bin/env bash
# Static analysis gate. Passes only on the literal "No issues found!": a
# sandboxed run that cannot write the SDK cache prints nothing and exits
# non-zero, and an empty result must never read as clean.
set -uo pipefail

if [ "${1:-}" = "--describe" ]; then
  echo '{"name":"analyze","tier":1,"summary":"fvm flutter analyze prints No issues found!","needs":[]}'
  exit 0
fi

cd "$(dirname "$0")/../../.." || exit 1
OUT=$(fvm flutter analyze 2>&1)
code=$?
echo "$OUT"
if [ "$code" -ne 0 ] || ! echo "$OUT" | grep -q "No issues found!"; then
  exit 1
fi
exit 0
